# Variáveis do back-end — MODELO, sem valores reais.
# Copie para backend/.env e preencha. O .env real NUNCA vai para o GitHub.
# Em produção os valores ficam no painel do Render (Environment). Ver docs/MIGRACAO.md.

# Banco de dados
MONGO_URL="mongodb://localhost:27017"
DB_NAME="app"

# Endereços
CORS_ORIGINS="https://seu-dominio.com"
APP_PUBLIC_URL="https://seu-dominio.com"
TRUSTED_PROXY_HOPS="2"
# segredo compartilhado com o proxy do Cloudflare (o Render gera sozinho)
PROXY_SHARED_SECRET=""

# Dono da plataforma (criado na primeira subida)
PLATFORM_OWNER_EMAIL=""
PLATFORM_OWNER_NAME=""
PLATFORM_OWNER_PASSWORD=""
BLOCKED_PASSWORDS=""

# E-mails
# Brevo (envio de e-mail). EMAIL_FROM_ADDRESS precisa estar verificado no Brevo.
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="Estoque Pro"
EMAIL_REPLY_TO=""

# Limites anti-abuso
LOGIN_LIMIT_PER_5MIN="8"
SIGNUP_LIMIT_PER_HOUR="5"

# Cron (backup diário + avisos de cobrança)
WEBHOOK_CRON_SECRET=""
BACKUP_DIR="/tmp/backups"
# cópia fora do servidor (opcional) — ver docs/BACKUP-EXTERNO.md

# Mercado Pago — ver docs/COBRANCA-MERCADO-PAGO.md
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
PAYMENT_GRACE_DAYS="5"

# Dados dos Termos de Uso / Privacidade
LEGAL_COMPANY_NAME=""
LEGAL_DOCUMENT=""
LEGAL_CONTACT_EMAIL=""
LEGAL_CITY=""
